import TruthCore.Isabelle.AFP.GoedelGod

/-!
Stipulative, finite-language controls for the Scott/AFP property domain.

These are *not* definitions from `GoedelGod.thy`, and the primitive predicate
is not yet justified as a metaphysically adequate qualitative vocabulary.
The admissible properties are exactly Boolean-valued functions of the one
declared atom at each individual/world pair. The language contains no separate
world or individual names, though a poorly chosen atom could itself encode
such names. The original AFP constant-domain quantification remains unchanged.
-/

namespace TruthCore.Isabelle.AFP.GoedelGod

open TruthCore.Modal

universe u v

/-- A Boolean-language property generated by one primitive state predicate.
`readout` ranges over all four unary Boolean truth functions; no independent
world-indexed property is introduced by a formula constructor. -/
def BooleanGeneratedProperty {World : Type u} {Ind : Type v}
    (atom : Ind → World → Bool) (Φ : Property World Ind) : Prop :=
  ∃ readout : Bool → Bool, ∀ x w, Φ x w ↔ readout (atom x w) = true

/-- The one-atom fragment contains its atom and the Boolean constants, and
is closed under negation and conjunction of admitted properties. -/
def BooleanFragmentClosed (World : Type u) (Ind : Type v) : Prop :=
  ∀ atom : Ind → World → Bool,
    BooleanGeneratedProperty atom (fun x w => atom x w = true) ∧
    BooleanGeneratedProperty atom (fun _ _ => True) ∧
    BooleanGeneratedProperty atom (fun _ _ => False) ∧
    (∀ Φ, BooleanGeneratedProperty atom Φ →
      BooleanGeneratedProperty atom (fun x w => ¬ Φ x w)) ∧
    (∀ Φ Ψ, BooleanGeneratedProperty atom Φ → BooleanGeneratedProperty atom Ψ →
      BooleanGeneratedProperty atom (fun x w => Φ x w ∧ Ψ x w))

/-- If the primitive atom never changes value for an individual, every
property expressible in the fragment is likewise invariant for that bearer.
The filtered `NE` therefore holds for that bearer in any frame. This is a
formal limitation of the fragment, not a metaphysical existence theorem. -/
def BooleanFragmentStableBearerNE (World : Type u) (Ind : Type v) : Prop :=
  ∀ (F : Frame World) (atom : Ind → World → Bool) (x : Ind),
    (∀ w next, atom x w = atom x next) →
    ∀ w, FilteredNecessaryExistence F (BooleanGeneratedProperty atom) x w

/-- There is one universally accessible two-world, two-individual model with
a non-world-invariant admissible property but no name for either the selected
world or selected individual in the one-atom fragment. Its filtered `NE` is
true for one bearer and false for the other, while full Scott `NE` fails for
the first. The countermodel does not assert a metaphysical possibility. -/
def BooleanFragmentNontrivialModel : Prop :=
  ∃ (F : Frame Bool) (atom : Bool → Bool → Bool),
    (∀ w next, F.access w next) ∧
    (∃ Φ, BooleanGeneratedProperty atom Φ ∧ ¬ WorldInvariantProperty Φ) ∧
    ¬ BooleanGeneratedProperty atom (fun _ w => w = false) ∧
    ¬ BooleanGeneratedProperty atom (fun x _ => x = false) ∧
    FilteredNecessaryExistence F (BooleanGeneratedProperty atom) false false ∧
    ¬ FilteredNecessaryExistence F (BooleanGeneratedProperty atom) true true ∧
    ¬ NecessaryExistence F false false

end TruthCore.Isabelle.AFP.GoedelGod
