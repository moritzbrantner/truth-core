module

public import TruthCore.Logic.Verificationism.Model
public import TruthCore.Isabelle.AFP.GoedelGod

/-!
Analyst comparison #1088 / #1010; attribution deferred. Reuse the existing
LawSentence syntax/evaluation and Nat→Bool×Bool valuation worlds. Its r0,b0,r1
are ONLY selected report coordinates here, not an asserted analysis of raven,
color, or metaphysical facts. No new propositional syntax is introduced.
Full joint independence means realization of every value in a supplied report
domain. Pairwise variation and truth-functional representability are different.
The two-report basis below covers ONLY the selected three-report Boolean
fragment, never the entire infinite valuation world or vocabulary.
-/

@[expose] public section
namespace TruthCore.Logic.AtomismIndependence
open TruthCore.Modal
open TruthCore.Isabelle.AFP.GoedelGod (Box)
open TruthCore.Logic.Verificationism.Model

/-- Root-relative full realization; neither a source attribution nor a claim
that all represented propositions are independently elementary. -/
def Saturates {W V : Type} (F : Frame W) (report : W → V) (a : W) : Prop :=
  ∀ value, ∃ w, F.access a w ∧ report w = value

/-- Under saturation, necessary constraints on these reports are exactly
constraints true at EVERY value in the supplied report domain. -/
def SaturationLaw : Prop :=
  ∀ (W V : Type) (F : Frame W) (report : W → V) (a : W),
    Saturates F report a → ∀ constraint : V → Prop,
      Box F (fun w => constraint (report w)) a ↔ ∀ value, constraint value

abbrev World := Nat → Bool × Bool
abbrev Triple := Bool × Bool × Bool

def reports (w : World) : Triple := ((w 0).1, (w 0).2, (w 1).1)
def basis (w : World) : Bool × Bool := w 0

/-- A nontrivial ternary constraint; it is not built into the original worlds. -/
def Parity (v : Triple) : Prop := v.2.2 = Bool.xor v.1 v.2.1
abbrev Constrained := {w : World // Parity (reports w)}

def unrestricted : Frame World := ⟨fun _ _ => True⟩
def constrained : Frame Constrained := ⟨fun _ _ => True⟩

/-- Four distinguished coordinates, leaving the rest explicitly fixed only
for these witnesses. Other worlds are unrestricted outside the selected triple. -/
def fill (p q r extra : Bool) : World
  | 0 => (p, q)
  | 1 => (r, extra)
  | _ => (false, false)

def make (p q : Bool) : Constrained := ⟨fill p q (Bool.xor p q) false, rfl⟩
def actual : Constrained := make false false

inductive Index where | first | second | third deriving DecidableEq

def coordinate (v : Triple) : Index → Bool
  | .first => v.1
  | .second => v.2.1
  | .third => v.2.2

/-- Each selected report can take either value at an admitted world. -/
def IndividualVariation : Prop :=
  ∀ i b, ∃ w : Constrained, constrained.access actual w ∧ coordinate (reports w.val) i = b

/-- ALL assignments to each pair of DISTINCT selected reports are realized. -/
def PairwiseVariation : Prop :=
  ∀ i j, i ≠ j → ∀ x y, ∃ w : Constrained,
    constrained.access actual w ∧ coordinate (reports w.val) i = x ∧
      coordinate (reports w.val) j = y

/-- Derived XOR uses the existing classical Boolean sentence operations. -/
def xorSentence : LawSentence :=
  .disj (.conj (.r 0) (.neg (.b 0))) (.conj (.neg (.r 0)) (.b 0))

/-- Exactly the Boolean fragment generated by r0,b0,r1; no law sentence,
other index or other coordinate is smuggled into its representation theorem. -/
inductive Selected : LawSentence → Prop where
  | first : Selected (.r 0)
  | second : Selected (.b 0)
  | third : Selected (.r 1)
  | neg {a} : Selected a → Selected (.neg a)
  | conj {a b} : Selected a → Selected b → Selected (.conj a b)
  | disj {a b} : Selected a → Selected b → Selected (.disj a b)

/-- Syntactic restriction on EXISTING sentences, not a second syntax. -/
def UsesBasis : LawSentence → Prop
  | .r n => n = 0
  | .b n => n = 0
  | .law => False
  | .neg a => UsesBasis a
  | .conj a b => UsesBasis a ∧ UsesBasis b
  | .disj a b => UsesBasis a ∧ UsesBasis b

/-- Reclassify r1 as a composite, leaving other atoms and the global law alone.
The advertised equivalence is restricted to Selected, not all old sentences. -/
def reanalyze : LawSentence → LawSentence
  | .r n => if n = 1 then xorSentence else .r n
  | .b n => .b n
  | .law => .law
  | .neg a => .neg (reanalyze a)
  | .conj a b => .conj (reanalyze a) (reanalyze b)
  | .disj a b => .disj (reanalyze a) (reanalyze b)

/-- SAME constrained profile: a saturated two-report basis and compositional
semantic elimination of the third report on the SELECTED fragment only. -/
def Reanalysis : Prop :=
  Saturates constrained (fun w => basis w.val) actual ∧
  (∀ a, Selected a → UsesBasis (reanalyze a) ∧
    ∀ w : Constrained, a.eval w.val ↔ (reanalyze a).eval w.val)

/-- Joint finite controls on the old (infinite-coordinate) world semantics.
Pairwise variation coexists with a necessary non-tautological constraint, but
not full triple saturation. Unrestricted worlds retain full triple saturation
and refute necessity of the constraint. Thus neither side alone is refuted. -/
def IndependenceControls : Prop :=
  IndividualVariation ∧ PairwiseVariation ∧
  Box constrained (fun w => Parity (reports w.val)) actual ∧
  ¬ Saturates constrained (fun w => reports w.val) actual ∧
  Saturates unrestricted reports actual.val ∧
  ¬ Box unrestricted (fun w => Parity (reports w)) actual.val ∧
  ¬ Parity (false, false, true)

/-- Equal basis and selected triple do NOT determine the whole old world:
the existing sentence b1 can differ on the SAME constrained profile. -/
def ScopeControl : Prop :=
  ∃ u v : Constrained, basis u.val = basis v.val ∧ reports u.val = reports v.val ∧
    LawSentence.eval u.val (.b 1) ∧ ¬ LawSentence.eval v.val (.b 1)

/-- General saturation scope law plus genuine joint independence, reanalysis
and incomplete-world representation controls. No actual atomism refutation. -/
def Certificate : Prop :=
  SaturationLaw ∧ IndependenceControls ∧ Reanalysis ∧ ScopeControl

end TruthCore.Logic.AtomismIndependence
