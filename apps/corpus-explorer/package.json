{
  "name": "@truth-core/corpus-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "test:browser": "bun --max-http-header-size=65536 test tests/*.browser.test.ts",
    "configuration-inputs": "python3 ../../scripts/corpus.py configuration-report --build-input",
    "structure-inputs": "python3 ../../scripts/worker_env.py -- python3 ../../scripts/corpus.py structure-report --build-input",
    "strength-inputs": "python3 ../../scripts/worker_env.py -- python3 ../../scripts/corpus.py strength-report --build-input"
  },
  "dependencies": {
    "@xyflow/react": "latest",
    "d3-force": "^3.0.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/d3-force": "3.0.10",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "latest",
    "playwright": "1.64.1",
    "tailwindcss": "latest",
    "typescript": "6.0.3"
  }
}
