  "lean_declaration": "TruthCore.Explanation.WellFoundedSource.emptyWorld",
  "bindings": {
    "World": "Unit",
    "Being": "Bool",
    "Model": "TruthCore.Explanation.WellFoundedSource.emptyWorld",
    "world": "Unit.unit"
  },
  "carriers": [
    {
      "binding": "World",
      "elements": ["Unit.unit"],
      "theorem": "TruthCore.Models.FiniteSupport.enumerateUnit"
    },
    {
      "binding": "Being",
      "elements": ["false", "true"],
      "theorem": "TruthCore.Models.FiniteSupport.enumerateBool"
    }
  ],
  "evaluations": [
    {
      "statement_id": "STMT-PSR-SOUND-COMPONENT",
      "value": "satisfies",
      "arguments": ["World", "Being", "Model"],
      "theorem": "TruthCore.Explanation.WellFoundedSource.emptyWorldSound"
    },
    {
      "statement_id": "STMT-PSR-EXISTENCE-COMPONENT",
      "value": "satisfies",
      "arguments": ["World", "Being", "Model"],
      "theorem": "TruthCore.Explanation.WellFoundedSource.emptyWorldPSR"
    },
    {
      "statement_id": "STMT-PSR-EXTERNAL-CAUSE-COMPONENT",
      "value": "satisfies",
      "arguments": ["World", "Being", "Model"],
      "theorem": "TruthCore.Explanation.WellFoundedSource.emptyWorldExternal"
    },
    {
      "statement_id": "STMT-PSR-POPULATED-AT",
      "value": "violates",
      "arguments": ["World", "Being", "Model", "world"],
      "theorem": "TruthCore.Explanation.WellFoundedSource.emptyWorldNotPopulated"
    },
    {
      "statement_id": "STMT-PSR-WELL-FOUNDED-CAUSES-AT",
      "value": "satisfies",
      "arguments": ["World", "Being", "Model", "world"],
      "theorem": "TruthCore.Explanation.WellFoundedSource.emptyWorldWellFounded"
    }
  ],
  "modules": ["TruthCore.Explanation.WellFoundedSource"]
