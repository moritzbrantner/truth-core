{
  "id": "MODEL-MODAL-VARIABLE-EFFECTS",
  "description": "Universal two-world frame, necessary particular source and three rigid candidate individuals. The source has a distinct existing effect in each world, but no one effect is caused in both worlds; the first effect is contingent. World-indexed causal edges have only the displayed coherence constraints.",
  "vocabulary": "MODAL-CAUSATION",
  "lean_declaration": "TruthCore.Modal.NecessaryVariableEffects.alternatingEffects",
  "bindings": {
    "World": "Bool",
    "Being": "TruthCore.Modal.NecessaryVariableEffects.EffectBeing",
    "Ontic": "TruthCore.Modal.NecessaryVariableEffects.alternatingEffects",
    "world": "false",
    "source": "TruthCore.Modal.NecessaryVariableEffects.source",
    "effect": "TruthCore.Modal.NecessaryVariableEffects.firstEffect"
  },
  "carriers": [
    {
      "binding": "World",
      "elements": ["false", "true"],
      "theorem": "TruthCore.Models.FiniteSupport.enumerateBool"
    },
    {
      "binding": "Being",
      "elements": [
        "TruthCore.Modal.NecessaryVariableEffects.source",
        "TruthCore.Modal.NecessaryVariableEffects.firstEffect",
        "TruthCore.Modal.NecessaryVariableEffects.secondEffect"
      ],
      "theorem": "TruthCore.Modal.NecessaryVariableEffects.enumerateEffectBeing"
    }
  ],
  "evaluations": [
    {
      "statement_id": "STMT-MODAL-SOUND-DISTINCT-CAUSES",
      "value": "satisfies",
      "arguments": ["World", "Being", "Ontic"],
      "theorem": "TruthCore.Modal.NecessaryVariableEffects.effectsSound"
    },
    {
      "statement_id": "STMT-KANT-CONVERSION-NECESSARY-WITNESS",
      "value": "satisfies",
      "arguments": ["World", "Being", "Ontic", "world"],
      "theorem": "TruthCore.Modal.NecessaryVariableEffects.sourceNecessary"
    },
    {
      "statement_id": "STMT-MODAL-NECESSARY-AT-INDIVIDUAL",
      "value": "satisfies",
      "arguments": ["World", "Being", "Ontic", "world", "source"],
      "theorem": "TruthCore.Modal.NecessaryVariableEffects.sourceNecessaryAt"
    },
    {
      "statement_id": "STMT-MODAL-NECESSARY-CAUSES-SOMETHING",
      "value": "satisfies",
      "arguments": ["World", "Being", "Ontic", "world", "source"],
      "theorem": "TruthCore.Modal.NecessaryVariableEffects.alwaysCausesSomething"
    },
    {
      "statement_id": "STMT-MODAL-SAME-NECESSARY-EFFECT",
      "value": "violates",
      "arguments": ["World", "Being", "Ontic", "world", "source"],
      "theorem": "TruthCore.Modal.NecessaryVariableEffects.noFixedEffect"
    },
    {
      "statement_id": "STMT-KANT-CONTINGENT-INDIVIDUAL",
      "value": "satisfies",
      "arguments": ["World", "Being", "Ontic", "world", "effect"],
      "theorem": "TruthCore.Modal.NecessaryVariableEffects.firstEffectContingent"
    }
  ],
  "modules": ["TruthCore.Modal.NecessaryVariableEffects"]
}
