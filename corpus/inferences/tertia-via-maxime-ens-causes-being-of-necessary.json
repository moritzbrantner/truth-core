{"id": "INF-TERTIA-VIA-MAXIME-ENS-CAUSES-BEING-OF-NECESSARY", "input_statement_ids": ["STMT-MAXIMUM-IN-GENUS-CAUSES-ALL-IN-GENUS", "STMT-NECESSARY-BEING-HAS-BEING"], "output_statement_id": "STMT-MAXIMUM-IN-BEING-CAUSES-BEING-OF-ANOTHER-NECESSARY", "rule": "universal-instantiation", "meaning": "Suppose a per se necessary being n were other than a maximum in being m. n has being, so by the genus principle at esse m causes its being.", "assumption_statement_ids": [], "discharged_statement_ids": []}
