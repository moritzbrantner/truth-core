{"id":"INF-AQUINAS-ST-I-Q2-A3-MOVED-BY-ANOTHER","input_statement_ids":["STMT-NOTHING-REDUCED-TO-ACT-EXCEPT-BY-A-MOVER","STMT-NOTHING-MOVES-ITSELF-IN-SAME-RESPECT"],"output_statement_id":"STMT-WHATEVER-IS-MOVED-IS-MOVED-BY-ANOTHER","rule":"existential-elimination-and-reductio","meaning":"Whatever is moved has a mover in that respect; the mover cannot be the moved thing itself; so it is another.","assumption_statement_ids":[],"discharged_statement_ids":[]}
